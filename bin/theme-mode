#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
windows_theme_dir="/mnt/c/Users/ptorn/.config"
local_mode_file="$config_home/theme-mode"
windows_mode_file="$windows_theme_dir/theme-mode"
mode_file="$local_mode_file"

tmux_theme_dir="$config_home/tmux"
eza_theme_dir="$config_home/eza"
eza_theme_current="$eza_theme_dir/theme.yml"

ensure_mode_file() {
  if [[ ! -f "$mode_file" ]]; then
    mkdir -p "$(dirname "$mode_file")"
    printf 'dark\n' > "$mode_file"
  fi
}

sync_windows_mode_file() {
  local value="$1"
  if [[ -d "$windows_theme_dir" && ( -w "$windows_theme_dir" || -w "$windows_mode_file" ) ]]; then
    mkdir -p "$windows_theme_dir"
    printf '%s\n' "$value" > "$windows_mode_file"
  fi
}

read_mode() {
  ensure_mode_file
  local value
  value="$(head -n 1 "$mode_file" 2>/dev/null || true)"
  if [[ "$value" == "light" ]]; then
    printf 'light\n'
    return
  fi
  printf 'dark\n'
}

reload_tmux() {
  local mode="$1"
  local source_file="$tmux_theme_dir/theme-${mode}.conf"

  [[ -f "$source_file" ]] || return 0

  if command -v tmux >/dev/null 2>&1; then
    tmux source-file "$source_file" 2>/dev/null || true
    if [[ "$mode" == "light" ]]; then
      tmux source-file "$tmux_theme_dir/statusline-light.conf" 2>/dev/null || true
    else
      tmux source-file "$tmux_theme_dir/statusline-dark.conf" 2>/dev/null || true
    fi
    tmux refresh-client -S 2>/dev/null || true
  fi
}

reload_eza_theme() {
  local mode="$1"
  local source_file="$eza_theme_dir/theme-${mode}.yml"
  [[ -f "$source_file" ]] || return 0
  cp "$source_file" "$eza_theme_current"
}

reload_wezterm() {
  if command -v wezterm >/dev/null 2>&1; then
    wezterm cli reload >/dev/null 2>&1 || true
  fi

  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command "wezterm cli reload" >/dev/null 2>&1 || true
  fi
}

set_mode() {
  local requested="$1"
  local current next

  current="$(read_mode)"

  case "$requested" in
    dark|light)
      next="$requested"
      ;;
    toggle)
      if [[ "$current" == "dark" ]]; then
        next="light"
      else
        next="dark"
      fi
      ;;
    *)
      echo "Usage: theme-mode [dark|light|toggle|show]" >&2
      return 1
      ;;
  esac

  if [[ "$next" != "$current" ]]; then
    printf '%s\n' "$next" > "$mode_file"
  else
    printf '%s\n' "$next" > "$mode_file"
  fi
  sync_windows_mode_file "$next"

  reload_tmux "$next"
  reload_eza_theme "$next"
  reload_wezterm
  printf '%s\n' "$next"
}

main() {
  local command="${1:-show}"

  case "$command" in
    show)
      read_mode
      ;;
    dark|light|toggle)
      set_mode "$command"
      ;;
    *)
      echo "Usage: theme-mode [dark|light|toggle|show]" >&2
      exit 1
      ;;
  esac
}

main "$@"
